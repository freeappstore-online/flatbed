{
  "name": "flatbed",
  "description": "Scan documents to PDF on your device: auto-crop, filters and multi-page export. Nothing leaves your phone.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/flatbed.git"
  },
  "scripts": {
    "dev": "pnpm --filter @flatbed/web dev",
    "build": "pnpm --filter @flatbed/web build",
    "preview": "pnpm --filter @flatbed/web preview",
    "typecheck": "pnpm --filter @flatbed/web exec tsc -b",
    "test": "pnpm check:tracking && pnpm --filter @flatbed/web test",
    "check:tracking": "node --test scripts/check-tracking.test.mjs && node scripts/check-tracking.mjs",
    "test:e2e": "pnpm --filter @flatbed/web test:e2e"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
